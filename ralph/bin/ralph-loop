#!/usr/bin/env bash
# 各Roleを1実行ずつ起動し、対象Taskがなくなるまで監視する。
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
使い方: ralph-loop [--config PATH] [worker|reviewer|manager ...]
EOF
  exit 1
}

RALPH_LOGGING_ACTIVE=false
RALPH_LOG_FILE=""
RALPH_LOG_PIPE_DIR=""
RALPH_LOG_PID=""
RALPH_LOG_ROLE_FILE=""

ralph_log() {
  local format="$1"
  shift
  if [[ "$RALPH_LOGGING_ACTIVE" == true ]]; then
    printf "$format" "$@"
  else
    printf '[%s] ' "$(date '+%Y-%m-%d %H:%M:%S')"
    printf "$format" "$@"
  fi
}

ralph_log_error() {
  ralph_log "$@" >&2
}

setup_logging() {
  local configured_path stdout_pipe stderr_pipe ready_file previous_umask backup_count
  configured_path="$(config_optional_string '.logging.path')"
  if [[ -z "$configured_path" ]]; then
    RALPH_LOG_FILE="$PROJECT_ROOT/.ralph/logs/ralph.log"
  elif [[ "$configured_path" == /* ]]; then
    RALPH_LOG_FILE="$configured_path"
  else
    RALPH_LOG_FILE="$PROJECT_ROOT/$configured_path"
  fi

  backup_count="$(jq -er '(if .logging.backupCount == null then 20 else .logging.backupCount end) | numbers | select(. >= 1 and . == floor)' "$CONFIG_PATH")" || {
    ralph_log_error 'logging.backupCountは1以上の整数で指定してください。\n'
    return 1
  }
  require_command python3
  previous_umask="$(umask)"
  umask 077
  mkdir -p "$(dirname "$RALPH_LOG_FILE")"
  umask "$previous_umask"

  RALPH_LOG_PIPE_DIR="$(mktemp -d "${TMPDIR:-/tmp}/ralph-log.XXXXXX")"
  RALPH_LOG_ROLE_FILE="$RALPH_LOG_PIPE_DIR/role"
  printf '%s' "$role" >"$RALPH_LOG_ROLE_FILE"
  stdout_pipe="$RALPH_LOG_PIPE_DIR/stdout"
  stderr_pipe="$RALPH_LOG_PIPE_DIR/stderr"
  mkfifo "$stdout_pipe" "$stderr_pipe"

  exec 3>&1 4>&2
  ready_file="$RALPH_LOG_PIPE_DIR/ready"
  python3 "$RALPH_ROOT/lib/log_stream.py" --log "$RALPH_LOG_FILE" \
    --stdout-pipe "$stdout_pipe" --stderr-pipe "$stderr_pipe" \
    --role-file "$RALPH_LOG_ROLE_FILE" --ready-file "$ready_file" \
    --backup-count "$backup_count" >&3 2>&4 &
  RALPH_LOG_PID=$!
  # Fail before opening the FIFOs if the logger could not initialize its output.
  while [[ ! -f "$ready_file" ]]; do
    if ! kill -0 "$RALPH_LOG_PID" 2>/dev/null; then
      wait "$RALPH_LOG_PID" 2>/dev/null || true
      rm -f "$stdout_pipe" "$stderr_pipe" "$RALPH_LOG_ROLE_FILE"
      rmdir "$RALPH_LOG_PIPE_DIR"
      ralph_log_error 'ログ出力の初期化に失敗しました。\n'
      return 1
    fi
    sleep 0.01
  done
  exec >"$stdout_pipe" 2>"$stderr_pipe"
  RALPH_LOGGING_ACTIVE=true
}

cleanup_logging() {
  [[ "$RALPH_LOGGING_ACTIVE" == true ]] || return
  RALPH_LOGGING_ACTIVE=false
  exec 1>&3 2>&4
  exec 3>&- 4>&-
  wait "$RALPH_LOG_PID" 2>/dev/null || true
  rm -f "$RALPH_LOG_PIPE_DIR/stdout" "$RALPH_LOG_PIPE_DIR/stderr" "$RALPH_LOG_ROLE_FILE" "$RALPH_LOG_PIPE_DIR/ready"
  rmdir "$RALPH_LOG_PIPE_DIR"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
RALPH_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
CONFIG_PATH=""

if [[ "${1:-}" == "--config" ]]; then
  [[ -n "${2:-}" ]] || usage
  CONFIG_PATH="$2"
  shift 2
fi

# Validate before creating runtime files. Deduplicate in the standard priority order.
if [[ $# -eq 0 ]]; then set -- manager reviewer worker; fi
requested_roles=("$@")
for candidate in "${requested_roles[@]}"; do
  case "$candidate" in
    worker | reviewer | manager) ;;
    *) usage ;;
  esac
done
selected_roles=()
for candidate in manager reviewer worker; do
  if [[ " ${requested_roles[*]} " == *" $candidate "* ]]; then
    selected_roles+=("$candidate")
  fi
done
mode=auto
if [[ ${#selected_roles[@]} -eq 1 ]]; then mode="${selected_roles[0]}"; fi
role="$mode"

if [[ -z "$CONFIG_PATH" ]]; then
  CONFIG_PATH="$PWD/.ralph/config.json"
fi
[[ -f "$CONFIG_PATH" ]] || {
  ralph_log_error 'Ralph設定が見つかりません: %s\n' "$CONFIG_PATH"
  exit 1
}
CONFIG_PATH="$(cd "$(dirname "$CONFIG_PATH")" && pwd)/$(basename "$CONFIG_PATH")"

require_command() {
  command -v "$1" >/dev/null 2>&1 || {
    ralph_log_error '必要なコマンドが見つかりません: %s\n' "$1"
    exit 1
  }
}

config_string() {
  local expression="$1"
  jq -er "$expression | strings | select(length > 0)" "$CONFIG_PATH"
}

config_optional_string() {
  local expression="$1"
  jq -r "$expression // empty | strings" "$CONFIG_PATH"
}

require_command jq
jq -e 'type == "object"' "$CONFIG_PATH" >/dev/null || {
  ralph_log_error 'Ralph設定はJSONオブジェクトである必要があります: %s\n' "$CONFIG_PATH"
  exit 1
}

PROJECT_ROOT="$(config_optional_string '.projectRoot')"
if [[ -z "$PROJECT_ROOT" ]]; then
  PROJECT_ROOT="$(cd "$(dirname "$CONFIG_PATH")/.." && pwd)"
elif [[ "$PROJECT_ROOT" != /* ]]; then
  PROJECT_ROOT="$(cd "$(dirname "$CONFIG_PATH")/../$PROJECT_ROOT" && pwd)"
fi
[[ -d "$PROJECT_ROOT" ]] || {
  ralph_log_error 'projectRootがディレクトリではありません: %s\n' "$PROJECT_ROOT"
  exit 1
}

if [[ "${RALPH_RUNNER_MANAGED:-}" != 1 ]]; then
  exec python3 "$SCRIPT_DIR/ralph" run --config "$CONFIG_PATH" "${selected_roles[@]}"
fi

RALPH_PROJECT_NAME="$(config_string '.projectName')"
TASK_BACKEND="$(config_string '.taskBackend')"
POLL_INTERVAL_SECONDS="$(jq -er '.pollIntervalSeconds // 300 | numbers | select(. >= 1) | floor' "$CONFIG_PATH")"
RETRY_INITIAL_SECONDS="$(jq -er '.retry.initialSeconds // 300 | numbers | select(. >= 1) | floor' "$CONFIG_PATH")"
RETRY_TOKEN_LIMIT_SECONDS="$(jq -er '.retry.tokenLimitSeconds // 1800 | numbers | select(. >= 1) | floor' "$CONFIG_PATH")"
IDLE_HEARTBEAT_SECONDS="$(jq -er '.logging.idleHeartbeatSeconds // 3600 | numbers | select(. >= 1) | floor' "$CONFIG_PATH")"
export RALPH_CONFIG_PATH="$CONFIG_PATH"
export RALPH_PROJECT_NAME
export RALPH_PROJECT_ROOT="$PROJECT_ROOT"

case "$TASK_BACKEND" in
  wacha) source "$RALPH_ROOT/backends/wacha.sh" ;;
  *)
    ralph_log_error '未対応のtaskBackendです: %s\n' "$TASK_BACKEND"
    exit 1
    ;;
esac

setup_logging
rendered_prompt=""
cleanup() {
  local exit_status=$?
  if [[ -n "${PROVIDER_PID:-}" ]]; then kill "$PROVIDER_PID" 2>/dev/null || true; wait "$PROVIDER_PID" 2>/dev/null || true; fi
  if [[ -n "${heartbeat_pid:-}" ]]; then kill "$heartbeat_pid" 2>/dev/null || true; wait "$heartbeat_pid" 2>/dev/null || true; fi
  cleanup_logging
  if [[ -n "$rendered_prompt" ]]; then
    rm -f "$rendered_prompt"
  fi
  return "$exit_status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

rendered_prompt="$(mktemp "${TMPDIR:-/tmp}/ralph-prompt.XXXXXX")"
backend_requirements

set_log_role() {
  if [[ "$role" == auto ]]; then
    printf '%s' scheduler >"$RALPH_LOG_ROLE_FILE"
  else
    printf '%s:%s' "$role" "$(state_command principal "$role")" >"$RALPH_LOG_ROLE_FILE"
  fi
}

set_role_identity() {
  if ! WACHA_AGENT_NAME="$(state_command principal "$1")"; then
    ralph_log_error 'roles.%s.agentNameを設定してください: %s\n' "$1" "$CONFIG_PATH"
    exit 1
  fi
  export WACHA_AGENT_NAME
}

prepare_role() {
  local selected_role="$1"
  local priority_status="${2:-}"
  local prompt_path prompt_content
  role="$selected_role"
  set_log_role
  set_role_identity "$role"
  AGENT_PROVIDER="$(config_optional_string ".roles.${role}.agentProvider")"
  if [[ -z "$AGENT_PROVIDER" ]]; then
    AGENT_PROVIDER="$(config_string '.agentProvider')"
  fi
  RALPH_AGENT_COMMAND="$(config_optional_string ".roles.${role}.command")"
  RALPH_AGENT_MODEL="$(config_optional_string ".roles.${role}.model")"
  export RALPH_AGENT_COMMAND RALPH_AGENT_MODEL
  case "$AGENT_PROVIDER" in
    claude) source "$RALPH_ROOT/providers/claude.sh" ;;
    codex) source "$RALPH_ROOT/providers/codex.sh" ;;
    *)
      ralph_log_error '未対応のagentProviderです: %s\n' "$AGENT_PROVIDER"
      exit 1
      ;;
  esac
  prompt_path="$(config_optional_string ".roles.${role}.prompt")"
  if [[ -z "$prompt_path" ]]; then
    prompt_path="$RALPH_ROOT/prompts/$role.md"
  elif [[ "$prompt_path" != /* ]]; then
    prompt_path="$PROJECT_ROOT/$prompt_path"
  fi
  [[ -f "$prompt_path" ]] || {
    ralph_log_error 'Promptが見つかりません: %s\n' "$prompt_path"
    exit 1
  }
  prompt_content="$(<"$prompt_path")"
  prompt_content="${prompt_content//\{\{PROJECT_NAME\}\}/$RALPH_PROJECT_NAME}"
  prompt_content="${prompt_content//\{\{PROJECT_ROOT\}\}/$PROJECT_ROOT}"
  printf '%s\n' "$prompt_content" >"$rendered_prompt"
  if [[ "$priority_status" == rejected ]]; then
    printf '\n今回の自動実行では、利用可能な`rejected` Taskを優先して1件選んでください。Task IDは自分で選び、以降は通常のWorker手順に従ってください。\n' >>"$rendered_prompt"
  fi
  provider_requirements
}

GITHUB_ENABLED="$(jq -r '.github.enabled // false' "$CONFIG_PATH")"
MAX_NO_PROGRESS="$(jq -er '.retry.maxNoProgressAttempts // 3 | numbers | select(. >= 1) | floor' "$CONFIG_PATH")"
GITHUB_HELPER="$RALPH_ROOT/lib/github_workflow.py"
RUNTIME_HELPER="$RALPH_ROOT/lib/runtime_state.py"
state_command() {
  local action="$1" selected_role="$2"
  shift 2
  python3 "$RUNTIME_HELPER" "$action" --config "$CONFIG_PATH" --role "$selected_role" "$@"
}
execution_path() { state_command path "$1"; }
task_summary() {
  local selected_role="$1" raw
  raw="$(backend_get_task_summary "$selected_role")" || return 1
  if [[ "$GITHUB_ENABLED" == true ]]; then
    printf '%s\n' "$raw" | python3 "$RALPH_ROOT/lib/execution_status.py" --config "$CONFIG_PATH" --role "$selected_role"
  else
    printf '%s\n' "$raw"
  fi
}
set_activity() {
  [[ "$role" != auto ]] || return 0
  state_command activity "$role" --value "$(jq -cn --arg phase "$1" --arg taskId "${active_task_id:-}" --arg title "${active_task_title:-}" --arg pid "${2:-}" --arg reason "${3:-}" '{phase:$phase,taskId:$taskId,title:$title,pid:$pid,reason:$reason}')"
}
ralph_agent_started() {
  set_activity agent_running "$1"
  ralph_log 'Agent実行開始 provider=%s pid=%s Task=%s [%s]\n' "$AGENT_PROVIDER" "$1" "${active_task_title:-}" "${active_task_id:-}"
}
ralph_agent_finished() {
  set_activity agent_finished
  ralph_log 'Agent実行終了 exit=%s Task=%s [%s]\n' "$1" "${active_task_title:-}" "${active_task_id:-}"
}
role_paused() { [[ "$(state_command paused "$1")" == true ]]; }
pause_role() {
  state_command pause "$1" --value "$2"
  ralph_log_error '%sを停止しました: %s。原因を解消後、ralph resume %s --principal %s で再開してください。\n' \
    "$1" "$2" "$1" "$(state_command principal "$1")"
}
record_no_progress() {
  local attempts
  attempts="$(state_command no-progress "$1")"
  if (( attempts >= MAX_NO_PROGRESS )); then pause_role "$1" 'Task状態が連続して進みませんでした'; fi
}
github_command() {
  local path
  path="$(execution_path "$role")"
  rm -f "${path%.json}.error.json"
  python3 "$GITHUB_HELPER" "$1" --config "$CONFIG_PATH" --role "$role"
}
github_failure_detail() {
  local path
  path="$(execution_path "$role")"
  path="${path%.json}.error.json"
  if [[ -f "$path" ]]; then
    jq -r '"処理=" + .phase + " 原因=" + .reason +
      (if .taskId then " Task=" + .taskId else "" end) +
      (if .prNumber then " PR=#" + (.prNumber|tostring) else "" end)' "$path"
  else
    printf '処理=%s 終了コード=%s（直前のエラーログを確認してください）' "$1" "$2"
  fi
}
provider_without_github_credentials() {
  local token_name token_value status index
  local -a token_names=() token_values=()
  while IFS= read -r token_name; do
    if [[ "$token_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n "${!token_name:-}" ]]; then
      token_names+=("$token_name")
      token_values+=("${!token_name}")
      unset "$token_name"
    fi
  done < <(jq -r '.github.tokenEnvs // {worker:"RALPH_GITHUB_TOKEN",reviewer:"RALPH_GITHUB_TOKEN",manager:"RALPH_GITHUB_TOKEN"} | ([.[]] + ["GH_TOKEN", "GITHUB_TOKEN", "WACHA_GITHUB_TOKEN"]) | unique[]' "$CONFIG_PATH")
  if provider_run "$rendered_prompt" "$execution_root"; then status=0; else status=$?; fi
  for ((index=0; index<${#token_names[@]}; index++)); do
    export "${token_names[index]}=${token_values[index]}"
  done
  return "$status"
}

quota_key() {
  jq -r --arg role "$1" '(.roles[$role].agentProvider // .agentProvider) + ":" + (.roles[$role].quotaKey // "default")' "$CONFIG_PATH"
}
quota_retry_at() {
  state_command quota "$1" --key "$(quota_key "$1")"
}
set_quota_retry_at() {
  state_command set-quota "$1" --key "$(quota_key "$1")" --value "$2"
}

AUTO_MANAGER_RETRY_AT=0
AUTO_REVIEWER_RETRY_AT=0
AUTO_WORKER_RETRY_AT=0

auto_role_retry_at() {
  case "$1" in
    manager) printf '%s\n' "$AUTO_MANAGER_RETRY_AT" ;;
    reviewer) printf '%s\n' "$AUTO_REVIEWER_RETRY_AT" ;;
    worker) printf '%s\n' "$AUTO_WORKER_RETRY_AT" ;;
  esac
}

auto_set_role_retry_at() {
  local retry_at="$2"
  case "$1" in
    manager) AUTO_MANAGER_RETRY_AT="$retry_at" ;;
    reviewer) AUTO_REVIEWER_RETRY_AT="$retry_at" ;;
    worker) AUTO_WORKER_RETRY_AT="$retry_at" ;;
  esac
}

select_auto_role() {
  local candidate candidate_summary pending retry_at quota_at
  local manager_summary='{"availableCount":0}' reviewer_summary='{"availableCount":0}' worker_summary='{"availableCount":0}'
  role=auto
  set_log_role
  for candidate in "${selected_roles[@]}"; do
    if role_paused "$candidate"; then continue; fi
    set_role_identity "$candidate"
    candidate_summary="$(task_summary "$candidate")" || return 1
    case "$candidate" in
      manager) manager_summary="$candidate_summary" ;;
      reviewer) reviewer_summary="$candidate_summary" ;;
      worker) worker_summary="$candidate_summary" ;;
    esac
    pending="$(backend_pending_count "$candidate" "$candidate_summary")"
    if [[ "$GITHUB_ENABLED" == true && -f "$(execution_path "$candidate")" ]]; then pending=1; fi
    retry_at="$(auto_role_retry_at "$candidate")"
    quota_at="$(quota_retry_at "$candidate")"
    if (( quota_at > retry_at )); then retry_at="$quota_at"; fi
    if (( pending > 0 && $(date +%s) >= retry_at )); then
      role="$candidate"
      set_log_role
      summary="$candidate_summary"
      return 0
    fi
  done
  role=auto
  summary="$(jq -cn --argjson manager "$manager_summary" \
    --argjson reviewer "$reviewer_summary" --argjson worker "$worker_summary" \
    '{manager: $manager, reviewer: $reviewer, worker: $worker}')"
}

if [[ "$mode" == auto ]]; then
  ralph_log 'Ralphを開始します。roles=%s log=%s\n' "${selected_roles[*]}" "$RALPH_LOG_FILE"
else
  prepare_role "$mode"
  ralph_log 'Ralphを開始します。provider=%s role=%s command=%s model=%s log=%s\n' \
    "$AGENT_PROVIDER" "$role" "${RALPH_AGENT_COMMAND:-default}" \
    "${RALPH_AGENT_MODEL:-default}" "$RALPH_LOG_FILE"
fi

wait_before_retry() {
  local reason="$1"
  local delay="${2:-$RETRY_INITIAL_SECONDS}"
  set_activity retry_wait "" "$reason"
  ralph_log_error '%s %d秒後に再試行します。\n' "$reason" "$delay"
  sleep "$delay"
}

last_idle_log_epoch=0
last_idle_summary=""

while true; do
  if ! state_command validate "${selected_roles[0]}"; then
    ralph_log_error '運用状態の検証に失敗しました。%s/.ralph/runtime.json と直前のエラーを確認してください。\n' "$PROJECT_ROOT"
    exit 78
  fi
  if [[ "$GITHUB_ENABLED" == true ]]; then
    for cleanup_role in "${selected_roles[@]}"; do
      if ! python3 "$GITHUB_HELPER" cleanup --config "$CONFIG_PATH" --role "$cleanup_role"; then
        ralph_log_error '%sの完了済みWorktree掃除を実行できませんでした。直前のエラーを確認してください。\n' "$cleanup_role"
      fi
    done
  fi
  if [[ "$mode" == auto ]]; then
    if ! select_auto_role; then
      wait_before_retry 'Wachaの状態取得に失敗しました。'
      continue
    fi
    if [[ "$role" == auto ]]; then
      pending=0
    else
      pending="$(backend_pending_count "$role" "$summary")"
    fi
  elif role_paused "$role" || (( $(date +%s) < $(quota_retry_at "$role") )); then
    sleep "$POLL_INTERVAL_SECONDS"
    continue
  elif ! summary="$(task_summary "$role")"; then
    wait_before_retry 'Wachaの状態取得に失敗しました。'
    continue
  else
    pending="$(backend_pending_count "$role" "$summary")"
  fi
  if [[ "$GITHUB_ENABLED" == true && "$role" != auto && -f "$(execution_path "$role")" ]]; then pending=1; fi
  if (( pending == 0 )); then
    current_epoch="$(date +%s)"
    normalized_summary="$(jq -cS . <<<"$summary")"
    if [[ "$mode" == auto ]]; then
      status="$(jq -r '[to_entries[] | "\(.key):実行可能=\(.value.availableCount // 0),保留=\(.value.deferredCount // 0)"] | join(" / ")' <<<"$summary")"
    else
      status="$(backend_format_status "$role" "$summary")"
    fi
    if (( last_idle_log_epoch == 0 )); then
      ralph_log '待機を開始します。%s 確認間隔=%d秒\n' "$status" "$POLL_INTERVAL_SECONDS"
      last_idle_log_epoch="$current_epoch"
    elif [[ "$normalized_summary" != "$last_idle_summary" ]]; then
      ralph_log '待機中にTask状態が変化しました。%s\n' "$status"
      last_idle_log_epoch="$current_epoch"
    elif (( current_epoch - last_idle_log_epoch >= IDLE_HEARTBEAT_SECONDS )); then
      ralph_log '待機中です。%s\n' "$status"
      last_idle_log_epoch="$current_epoch"
    fi
    if [[ "$normalized_summary" != "$last_idle_summary" ]]; then
      jq -r '[.. | objects | select(has("deferred")) | .deferred[]?] | unique_by(.taskId)[] | "保留Task=\(.title) [\(.taskId)] 理由=\(.reason) 記録=\(.recordPath)"' <<<"$summary" | while IFS= read -r deferred_line; do ralph_log '%s\n' "$deferred_line"; done
    fi
    set_activity waiting
    last_idle_summary="$normalized_summary"
    sleep "$POLL_INTERVAL_SECONDS"
    continue
  fi

  last_idle_log_epoch=0
  last_idle_summary=""
  if [[ "$mode" == auto ]]; then
    priority_status=""
    if [[ "$role" == worker && "$(jq -r '.availableRejected' <<<"$summary")" -gt 0 ]]; then
      priority_status=rejected
    fi
    prepare_role "$role" "$priority_status"
  fi
  backend_print_status "$role" "$summary"
  execution_root="$PROJECT_ROOT"
  RALPH_PREPARATION_DIRECTORY=""
  recovery_run=false
  recovery_timeout_seconds=0
  heartbeat_pid=""
  if [[ "$GITHUB_ENABLED" == true ]]; then
    if context="$(github_command prepare)"; then
      if [[ "$(jq -r '.idle // false' <<<"$context")" == true ]]; then
        ralph_log '選択処理後の実行対象なし。Agentは起動しません。\n'
        if [[ "$mode" == auto ]]; then auto_set_role_retry_at "$role" "$(($(date +%s) + POLL_INTERVAL_SECONDS))"; else sleep "$POLL_INTERVAL_SECONDS"; fi
        continue
      fi
      active_task_id="$(jq -r '.task.id // ""' <<<"$context")"
      active_task_title="$(jq -r '.task.title // ""' <<<"$context")"
      execution_root="$(jq -r '.cwd' <<<"$context")"
      RALPH_PREPARATION_DIRECTORY="$(jq -r '.verificationPreparation.directory // ""' <<<"$context")"
      recovery_run="$(jq -r '.recovery // false' <<<"$context")"
      recovery_timeout_seconds="$(jq -r '.recoveryTimeoutSeconds // 0' <<<"$context")"
      if [[ "$(jq -r '.pending // false' <<<"$context")" != true ]]; then
        github_prompt="$(config_optional_string ".roles.${role}.githubPrompt")"
        if [[ "$recovery_run" == true ]]; then github_prompt="$RALPH_ROOT/prompts/github-recovery.md";
        elif [[ -z "$github_prompt" ]]; then github_prompt="$RALPH_ROOT/prompts/github-$role.md";
        elif [[ "$github_prompt" != /* ]]; then github_prompt="$PROJECT_ROOT/$github_prompt"; fi
        [[ -f "$github_prompt" ]] || { pause_role "$role" 'GitHub Promptが見つかりません'; continue; }
        cat "$github_prompt" >"$rendered_prompt"
        printf '\n実行Context（TaskとClaimはRalphが取得済み）:\n%s\n' "$context" >>"$rendered_prompt"
      fi
    else
      github_status=$?
      detail="$(github_failure_detail prepare "$github_status")"
      if (( github_status == 76 || github_status == 79 )); then ralph_log '%s\n' "$detail"; continue; fi
      if (( github_status == 78 )); then pause_role "$role" "$detail"; fi
      wait_before_retry "$detail"
      continue
    fi
    if [[ "$(jq -r '.pending // false' <<<"$context")" == true ]]; then
      ralph_log '保存済み結果を反映します。Task=%s [%s]\n' "$active_task_title" "$active_task_id"
      set_activity applying
      if github_command finish; then
        state_command progress "$role"
      else
        github_status=$?
        if (( github_status == 79 )); then ralph_log 'Taskを保留しました。他のTaskを確認します。\n'; continue; fi
        if (( github_status == 76 )); then
          ralph_log '%sへ再判定・修正を返します。同じWorktreeと保存済みの検証記録を引き継ぎます。\n' "$role"
          continue
        fi
        detail="$(github_failure_detail finish "$github_status")"
        if (( github_status == 78 )); then pause_role "$role" "$detail"; fi
        wait_before_retry "$detail"
      fi
      continue
    fi
    python3 "$GITHUB_HELPER" watch --config "$CONFIG_PATH" --role "$role" &
    heartbeat_pid=$!
  fi
  export RALPH_RECOVERY_TIMEOUT_SECONDS="${recovery_timeout_seconds:-0}"
  if provider_without_github_credentials; then
    provider_status=0
  else
    provider_status=$?
  fi
  if [[ -n "$heartbeat_pid" ]]; then kill "$heartbeat_pid" 2>/dev/null || true; wait "$heartbeat_pid" 2>/dev/null || true; fi
  if (( provider_status != 0 )); then
    PROVIDER_TOKEN_LIMIT_RESET_PARSED=false
    PROVIDER_TOKEN_LIMIT_RETRY_SECONDS=""
    if provider_hit_token_limit; then
      if [[ "$PROVIDER_TOKEN_LIMIT_RESET_PARSED" == true ]]; then
        retry_delay="$PROVIDER_TOKEN_LIMIT_RETRY_SECONDS"
        retry_reason="${role}がToken上限に達しました。Reset時刻を検出しました。"
      else
        retry_delay="$RETRY_TOKEN_LIMIT_SECONDS"
        retry_reason="${role}がToken上限に達しました。"
      fi
      set_quota_retry_at "$role" "$(($(date +%s) + retry_delay))"
      if [[ "$mode" == auto ]]; then
        auto_set_role_retry_at "$role" "$(($(date +%s) + retry_delay))"
        ralph_log_error '%s %d秒間このRoleを待機し、次のRoleを確認します。\n' \
          "$retry_reason" "$retry_delay"
      else
        wait_before_retry "$retry_reason" "$retry_delay"
      fi
    elif (( recovery_timeout_seconds > 0 )); then
      if github_command agent-failed; then :; else
        recovery_status=$?
        if (( recovery_status != 76 && recovery_status != 79 )); then
          pause_role "$role" "$(github_failure_detail recover "$recovery_status")"
        fi
      fi
    else
      record_no_progress "$role"
      wait_before_retry "${role}が終了コード ${provider_status} で終了しました。"
    fi
    continue
  fi

  if [[ "$GITHUB_ENABLED" == true ]]; then
    github_final_command=finish
    if [[ "$recovery_run" == true ]]; then github_final_command=recover; fi
    set_activity applying
    ralph_log '結果反映開始 operation=%s Task=%s [%s]\n' "$github_final_command" "$active_task_title" "$active_task_id"
    if github_command "$github_final_command"; then
      state_command progress "$role"
    else
      github_status=$?
      if (( github_status == 79 )); then ralph_log 'Taskを保留しました。他のTaskを確認します。\n'; continue; fi
      if (( github_status == 76 )); then
        ralph_log '%sへ再判定・修正を返します。同じWorktreeと保存済みの検証記録を引き継ぎます。\n' "$role"
        continue
      fi
      detail="$(github_failure_detail finish "$github_status")"
      if (( github_status == 76 || github_status == 79 )); then ralph_log '%s\n' "$detail"; continue; fi
      if (( github_status == 78 )); then pause_role "$role" "$detail"; fi
      wait_before_retry "$detail"
    fi
    continue
  fi
  if ! updated_summary="$(task_summary "$role")"; then
    wait_before_retry 'Agent実行後のWacha状態取得に失敗しました。'
    continue
  fi
  if [[ "$(jq -cS . <<<"$summary")" == "$(jq -cS . <<<"$updated_summary")" ]]; then
    record_no_progress "$role"
    wait_before_retry "${role}実行後もTask状態が変化しませんでした。"
    continue
  else
    state_command progress "$role"
  fi
done
