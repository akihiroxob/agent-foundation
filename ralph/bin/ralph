#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
from pathlib import Path

RUNTIME_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = RUNTIME_ROOT / "examples" / "config.json"
LOOP_COMMAND = RUNTIME_ROOT / "bin" / "ralph-loop"


def find_project_root(explicit: Path | None = None) -> Path:
    if explicit is not None:
        root = explicit.expanduser().resolve()
    else:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=False,
        )
        root = Path(result.stdout.strip()).resolve() if result.returncode == 0 else Path.cwd().resolve()

    if not root.is_dir():
        raise ValueError(f"Project directory does not exist: {root}")
    return root


def initialize_project(root: Path, project_name: str | None, force: bool) -> tuple[Path, bool]:
    config_path = root / ".ralph" / "config.json"
    if config_path.exists() and not force:
        return config_path, False

    config = json.loads(DEFAULT_CONFIG.read_text(encoding="utf-8"))
    config["projectName"] = project_name or root.name
    config_path.parent.mkdir(exist_ok=True)
    config_path.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return config_path, True


def read_json_object(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError(f"Invalid JSON in {path}: {error}") from error
    if not isinstance(value, dict):
        raise ValueError(f"JSON root must be an object: {path}")
    return value


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def configure_claude(root: Path, config_path: Path) -> tuple[Path, Path]:
    config = read_json_object(config_path)
    wacha = config.get("wacha")
    if not isinstance(wacha, dict) or not isinstance(wacha.get("url"), str) or not wacha["url"]:
        raise ValueError(f"wacha.url must be a non-empty string: {config_path}")

    mcp_path = root / ".mcp.json"
    mcp_config = read_json_object(mcp_path)
    mcp_servers = mcp_config.setdefault("mcpServers", {})
    if not isinstance(mcp_servers, dict):
        raise ValueError(f"mcpServers must be an object: {mcp_path}")
    mcp_servers["wacha"] = {
        "type": "http",
        "url": wacha["url"],
        "headers": {"Authorization": "Bearer ${WACHA_AGENT_NAME}"},
    }

    settings_path = root / ".claude" / "settings.json"
    settings = read_json_object(settings_path)
    permissions = settings.setdefault("permissions", {})
    if not isinstance(permissions, dict):
        raise ValueError(f"permissions must be an object: {settings_path}")
    allowed_tools = permissions.setdefault("allow", [])
    if not isinstance(allowed_tools, list) or not all(isinstance(item, str) for item in allowed_tools):
        raise ValueError(f"permissions.allow must be a string array: {settings_path}")
    if "mcp__wacha" not in allowed_tools:
        allowed_tools.append("mcp__wacha")

    enabled_servers = settings.setdefault("enabledMcpjsonServers", [])
    if not isinstance(enabled_servers, list) or not all(isinstance(item, str) for item in enabled_servers):
        raise ValueError(f"enabledMcpjsonServers must be a string array: {settings_path}")
    if "wacha" not in enabled_servers:
        enabled_servers.append("wacha")

    write_json(mcp_path, mcp_config)
    write_json(settings_path, settings)
    return mcp_path, settings_path


def init_command(args: argparse.Namespace) -> int:
    try:
        root = find_project_root(args.project_root)
    except ValueError as error:
        print(error)
        return 2

    config_path, created = initialize_project(root, args.project_name, args.force)
    try:
        mcp_path, settings_path = configure_claude(root, config_path)
    except ValueError as error:
        print(error)
        return 2
    action = "created" if created else "kept existing"
    print(f"{action} config: {config_path}")
    print(f"configured Claude MCP: {mcp_path}")
    print(f"configured Claude permissions: {settings_path}")
    return 0


def run_command(args: argparse.Namespace) -> int:
    try:
        root = find_project_root(args.project_root)
    except ValueError as error:
        print(error)
        return 2

    config_path = args.config.expanduser().resolve() if args.config else root / ".ralph" / "config.json"
    if not config_path.is_file():
        print(f"Ralph config does not exist: {config_path}")
        print("Run `ralph init` in the project first.")
        return 2

    environment = os.environ.copy()
    os.execve(
        LOOP_COMMAND,
        [str(LOOP_COMMAND), "--config", str(config_path), args.role],
        environment,
    )


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ralph", description="Run disposable Worker and Reviewer agents.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser("init", help="Create repository-specific Ralph configuration.")
    init_parser.add_argument("--project-root", type=Path)
    init_parser.add_argument("--project-name")
    init_parser.add_argument("--force", action="store_true")
    init_parser.set_defaults(handler=init_command)

    run_parser = subparsers.add_parser("run", help="Run a Worker or Reviewer loop.")
    run_parser.add_argument("role", choices=("worker", "reviewer"))
    run_parser.add_argument("--project-root", type=Path)
    run_parser.add_argument("--config", type=Path)
    run_parser.set_defaults(handler=run_command)
    return parser


def main() -> int:
    args = build_parser().parse_args()
    return args.handler(args)


if __name__ == "__main__":
    raise SystemExit(main())
