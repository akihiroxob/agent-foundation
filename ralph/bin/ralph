#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import subprocess
import signal
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "lib"))
from managed_process import run_managed
from runtime_state import (acquire_roles, execution_path, migrate, operate,
                           project_root, read_object, component)

RUNTIME_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_CONFIG = RUNTIME_ROOT / "examples" / "config.json"
LOOP_COMMAND = RUNTIME_ROOT / "bin" / "ralph-loop"


def find_project_root(explicit: Path | None = None) -> Path:
    if explicit is not None:
        root = explicit.expanduser().resolve()
    else:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True,
            text=True,
            check=False,
        )
        root = Path(result.stdout.strip()).resolve() if result.returncode == 0 else Path.cwd().resolve()

    if not root.is_dir():
        raise ValueError(f"Project directory does not exist: {root}")
    return root


def initialize_project(
    root: Path, project_name: str | None, agent_provider: str, force: bool
) -> tuple[Path, bool]:
    config_path = root / ".ralph" / "config.json"
    if config_path.exists() and not force:
        return config_path, False

    config = json.loads(DEFAULT_CONFIG.read_text(encoding="utf-8"))
    config["projectName"] = project_name or root.name
    config["agentProvider"] = agent_provider
    for role_config in config.get("roles", {}).values():
        if isinstance(role_config, dict):
            role_config["agentProvider"] = agent_provider
    config_path.parent.mkdir(exist_ok=True)
    config_path.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    return config_path, True


def read_json_object(path: Path) -> dict:
    if not path.exists():
        return {}
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as error:
        raise ValueError(f"Invalid JSON in {path}: {error}") from error
    if not isinstance(value, dict):
        raise ValueError(f"JSON root must be an object: {path}")
    return value


def write_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def configure_claude(root: Path, config_path: Path) -> tuple[Path, Path]:
    config = read_json_object(config_path)
    wacha = config.get("wacha")
    if not isinstance(wacha, dict) or not isinstance(wacha.get("url"), str) or not wacha["url"]:
        raise ValueError(f"wacha.url must be a non-empty string: {config_path}")

    mcp_path = root / ".mcp.json"
    mcp_config = read_json_object(mcp_path)
    mcp_servers = mcp_config.setdefault("mcpServers", {})
    if not isinstance(mcp_servers, dict):
        raise ValueError(f"mcpServers must be an object: {mcp_path}")
    mcp_servers["wacha"] = {
        "type": "http",
        "url": wacha["url"],
        "headers": {"Authorization": "Bearer ${WACHA_AGENT_NAME}"},
    }

    settings_path = root / ".claude" / "settings.json"
    settings = read_json_object(settings_path)
    permissions = settings.setdefault("permissions", {})
    if not isinstance(permissions, dict):
        raise ValueError(f"permissions must be an object: {settings_path}")
    allowed_tools = permissions.setdefault("allow", [])
    if not isinstance(allowed_tools, list) or not all(isinstance(item, str) for item in allowed_tools):
        raise ValueError(f"permissions.allow must be a string array: {settings_path}")
    if "mcp__wacha" not in allowed_tools:
        allowed_tools.append("mcp__wacha")

    enabled_servers = settings.setdefault("enabledMcpjsonServers", [])
    if not isinstance(enabled_servers, list) or not all(isinstance(item, str) for item in enabled_servers):
        raise ValueError(f"enabledMcpjsonServers must be a string array: {settings_path}")
    if "wacha" not in enabled_servers:
        enabled_servers.append("wacha")

    write_json(mcp_path, mcp_config)
    write_json(settings_path, settings)
    return mcp_path, settings_path


def init_command(args: argparse.Namespace) -> int:
    try:
        root = find_project_root(args.project_root)
    except ValueError as error:
        print(error)
        return 2

    config_path, created = initialize_project(
        root, args.project_name, args.agent_provider, args.force
    )
    try:
        config = read_json_object(config_path)
        agent_provider = config.get("agentProvider", "claude")
        if agent_provider == "claude":
            mcp_path, settings_path = configure_claude(root, config_path)
        elif agent_provider != "codex":
            raise ValueError(f"Unsupported agentProvider in {config_path}: {agent_provider}")
    except ValueError as error:
        print(error)
        return 2
    action = "created" if created else "kept existing"
    print(f"{action} config: {config_path}")
    if agent_provider == "claude":
        print(f"configured Claude MCP: {mcp_path}")
        print(f"configured Claude permissions: {settings_path}")
    else:
        print("Codex Wacha MCP is configured at runtime.")
    return 0


def run_command(args: argparse.Namespace) -> int:
    try:
        root = find_project_root(args.project_root)
    except ValueError as error:
        print(error)
        return 2

    config_path = args.config.expanduser().resolve() if args.config else root / ".ralph" / "config.json"
    if not config_path.is_file():
        print(f"Ralph config does not exist: {config_path}")
        print("Run `ralph init` in the project first.")
        return 2

    config = read_object(config_path)
    root = project_root(config_path, config)
    handles = []
    try:
        identities = {role: args.principal if args.principal is not None else config["roles"][role]["agentName"]
                      for role in dict.fromkeys(args.roles)}
        for principal in identities.values():
            component(principal)
        migrate(root, config)
        lock_identities = dict(identities)
        if not config.get("github", {}).get("enabled", False):
            # Legacy agents operate directly in the shared checkout, not isolated worktrees.
            lock_identities["local-checkout"] = "legacy"
        handles = acquire_roles(root, lock_identities)
        environment = os.environ.copy()
        environment["RALPH_ROLE_PRINCIPALS"] = json.dumps(identities)
        environment["RALPH_RUNNER_MANAGED"] = "1"
        return run_managed([str(LOOP_COMMAND), "--config", str(config_path), *args.roles],
                           env=environment, pass_fds=tuple(handles))
    except (ValueError, KeyError, OSError) as error:
        print(str(error), file=sys.stderr)
        return 2
    finally:
        for descriptor in handles:
            os.close(descriptor)


def resume_command(args: argparse.Namespace) -> int:
    root = find_project_root(args.project_root)
    config_path = args.config.expanduser().resolve() if args.config else root / ".ralph/config.json"
    config = read_object(config_path)
    root = project_root(config_path, config)
    roles = ("worker", "reviewer", "manager") if args.role == "all" else (args.role,)
    migrate(root, config)
    for role in roles:
        principal = args.principal if args.principal is not None else config["roles"][role]["agentName"]
        component(principal)
        if args.discard_execution:
            # Destructive recovery must not race a live runner of this identity.
            handles = acquire_roles(root, {role: principal})
            try:
                if execution_path(root, principal, role).exists():
                    helper = RUNTIME_ROOT / "lib" / "github_workflow.py"
                    environment = os.environ.copy()
                    environment["RALPH_ROLE_PRINCIPALS"] = json.dumps({role: principal})
                    result = subprocess.run(["python3", str(helper), "abandon", "--config", str(config_path), "--role", role],
                                            env=environment, check=False)
                    if result.returncode:
                        return result.returncode
            finally:
                for descriptor in handles:
                    os.close(descriptor)
        operate(root, principal, role, "resume")
        print(f"resumed {role} principal={principal}; retained Claim/worktree and pending decisions; deferred Tasks eligible for restoration")
    return 0


def status_command(args: argparse.Namespace) -> int:
    from execution_status import status_lines
    root = find_project_root(args.project_root)
    config_path = args.config.expanduser().resolve() if args.config else root / ".ralph/config.json"
    config = read_object(config_path)
    root = project_root(config_path, config)
    if args.principal:
        component(args.principal)
    for line in status_lines(root, config, args.principal):
        print(line)
    return 0


def parse_role(value: str) -> str:
    if value not in ("worker", "reviewer", "manager"):
        raise argparse.ArgumentTypeError(
            f"invalid choice: {value!r} (choose from worker, reviewer, manager)"
        )
    return value


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="ralph", description="Run disposable Worker, Reviewer, and Manager agents.")
    subparsers = parser.add_subparsers(dest="command", required=True)

    init_parser = subparsers.add_parser("init", help="Create repository-specific Ralph configuration.")
    init_parser.add_argument("--project-root", type=Path)
    init_parser.add_argument("--project-name")
    init_parser.add_argument("--agent-provider", choices=("claude", "codex"), default="claude")
    init_parser.add_argument("--force", action="store_true")
    init_parser.set_defaults(handler=init_command)

    run_parser = subparsers.add_parser("run", help="Run selected roles in priority order (default: all roles).")
    run_parser.add_argument("roles", nargs="*", type=parse_role, metavar="ROLE",
                            default=["manager", "reviewer", "worker"],
                            help="Roles to run; multiple roles use Manager → Reviewer → Worker priority.")
    run_parser.add_argument("--project-root", type=Path)
    run_parser.add_argument("--config", type=Path)
    run_parser.add_argument("--principal", "-p", help="Override the Principal for every selected role.")
    run_parser.set_defaults(handler=run_command)
    status = subparsers.add_parser("status", help="Show Runner, Agent and deferred Task state without remote operations")
    status.add_argument("--project-root", type=Path)
    status.add_argument("--config", type=Path)
    status.add_argument("--principal", "-p")
    status.set_defaults(handler=status_command)
    resume = subparsers.add_parser("resume", help="Resume a role after fixing its blocker")
    resume.add_argument("role", choices=["all", "worker", "reviewer", "manager"])
    resume.add_argument("--project-root", type=Path)
    resume.add_argument("--config", type=Path)
    resume.add_argument("--principal", "-p", help="Principal whose pause should be cleared.")
    resume.add_argument("--discard-execution", action="store_true", help="Release Claim and archive pending execution; keep worktrees")
    resume.set_defaults(handler=resume_command)

    return parser


def main() -> int:
    args = build_parser().parse_args()
    try:
        return args.handler(args)
    except (ValueError, KeyError, OSError) as error:
        print(str(error), file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
